{
  "type": "object",
  "additionalProperties": false,
  "required": ["passed", "steps", "failure_reason", "playwright_spec", "vault_update"],
  "properties": {
    "passed": { "type": "boolean" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "selector", "value"],
        "properties": {
          "action": { "type": "string" },
          "selector": { "type": ["string", "null"] },
          "value": { "type": ["string", "null"] }
        }
      }
    },
    "failure_reason": { "type": ["string", "null"] },
    "playwright_spec": {
      "type": ["string", "null"],
      "description": "Complete @playwright/test spec file (TypeScript) reproducing every verified step"
    },
    "vault_update": {
      "type": ["string", "null"],
      "description": "Vault note path + row/field changed when a tracked feature_key was verified, per Skill - E2E Feature Verification; null if no vault tracking was requested"
    }
  }
}
