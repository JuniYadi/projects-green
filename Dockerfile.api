# Build stage — compile TS, generate Prisma client
FROM oven/bun:1-alpine AS builder
RUN apk update && apk upgrade --no-cache

WORKDIR /app

# Install all dependencies
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --ignore-scripts

COPY tsconfig.json ./

# Generate Prisma client
COPY prisma ./prisma
COPY prisma.config.ts ./
ENV DATABASE_URL=postgresql://localhost:5432/dummy
RUN bun prisma generate
COPY scripts ./scripts
RUN bun run scripts/copy-standard-fonts.ts

# Bundle API server & WebSocket gateway with inlined JS dependencies
COPY lib ./lib
COPY modules ./modules
COPY public ./public
RUN bun run scripts/build-api-server.ts

# ── Production stage ────────────────────────────────────────────────────────
FROM oven/bun:1-alpine
RUN apk update && apk upgrade --no-cache

WORKDIR /app

# Install ONLY runtime database and native dependencies
RUN bun add --exact --ignore-scripts \
  @prisma/client@7.10.0 \
  @prisma/adapter-pg@7.10.0 \
  pg@8.23.0 \
  ssh2@1.17.0 \
  && rm -rf /root/.bun

# Copy generated Prisma client from builder
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma

# Copy Prisma schema
COPY --from=builder /app/prisma ./prisma

# Copy bundled API server and native assets
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/public ./public
COPY --from=builder /app/standard-fonts ./standard-fonts

ENV NODE_ENV=production
EXPOSE 3301

STOPSIGNAL SIGTERM

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD ["sh", "-c", "wget -qO- http://127.0.0.1:3301/api/health || exit 1"]

CMD ["bun", "run", "dist/api-server.js"]
