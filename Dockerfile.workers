# Build stage — compile TS, generate Prisma client
FROM oven/bun:1-alpine AS builder

WORKDIR /app

# Install all dependencies (including dev for Prisma CLI + build)
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --ignore-scripts

# Copy config for @/ path aliases
COPY tsconfig.json ./

# Generate Prisma client (dummy URL — generate never connects to DB)
COPY prisma ./prisma
ENV DATABASE_URL=postgresql://localhost:5432/dummy
RUN bun prisma generate

# Bundle worker code with inlined JS dependencies (BullMQ, ioredis, AI SDK, etc.)
# Keep only native/engine packages external (@prisma/client, @prisma/adapter-pg, pg)
COPY scripts ./scripts
COPY lib ./lib
COPY modules ./modules
RUN bun build ./scripts/workers.ts \
  --target=bun \
  --outfile=./dist/workers.js \
  --external @prisma/client \
  --external @prisma/adapter-pg \
  --external pg \
  --external ssh2

RUN bun build ./scripts/schedule-runner.ts \
  --target=bun \
  --outfile=./dist/schedule-runner.js \
  --external @prisma/client \
  --external @prisma/adapter-pg \
  --external pg \
  --external ssh2

# ── Production stage ────────────────────────────────────────────────────────
FROM oven/bun:1-alpine

WORKDIR /app

# Install ONLY runtime database and native dependencies (no heavy web/frontend packages)
RUN bun add --exact --ignore-scripts \
  @prisma/client@7.8.0 \
  @prisma/adapter-pg@7.8.0 \
  pg@8.20.0 \
  ssh2@1.17.0
# Copy generated Prisma client from builder (schema-specific types & engine)
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma

# Copy Prisma schema (needed for runtime introspection / migration status)
COPY --from=builder /app/prisma ./prisma

# Copy the bundled worker and native assets
COPY --from=builder /app/dist ./dist

ENV NODE_ENV=production

# Kubernetes sends SIGTERM before the grace period expires.
STOPSIGNAL SIGTERM

# The worker has no HTTP server; its PID 1 process is the liveness signal.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD ["sh", "-c", "kill -0 1"]

CMD ["bun", "run", "dist/workers.js"]
