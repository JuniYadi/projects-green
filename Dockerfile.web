# Build stage
FROM oven/bun:1-alpine AS builder
RUN apk update && apk upgrade --no-cache

WORKDIR /app

# Copy package files
COPY package.json bun.lock ./

# Install dependencies (including dev for build)
RUN bun install --frozen-lockfile --ignore-scripts

# Copy source code
COPY . .

# Generate Prisma client (dummy URL — generate never connects)
ENV DATABASE_URL=postgresql://localhost:5432/dummy
RUN bun prisma generate

# AuthKit inlines this public callback during the Next.js build. Keep the
# production value in the image build input; runtime Pod env cannot override it.
ARG NEXT_PUBLIC_WORKOS_REDIRECT_URI
ENV NEXT_PUBLIC_WORKOS_REDIRECT_URI=${NEXT_PUBLIC_WORKOS_REDIRECT_URI}
RUN test -n "$NEXT_PUBLIC_WORKOS_REDIRECT_URI" || \
  (echo "NEXT_PUBLIC_WORKOS_REDIRECT_URI is required for the web image build" >&2 && exit 1)

# Build Next.js
RUN bun run build

# Production stage
FROM oven/bun:1-alpine
RUN apk update && apk upgrade --no-cache

WORKDIR /app

# Copy standalone build and static assets
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public

# Copy Prisma schema for runtime migrations/introspection
COPY prisma ./prisma

# Set production environment and expose port
ENV NODE_ENV=production
ENV PORT=3300
ENV HOSTNAME="0.0.0.0"
EXPOSE 3300

# Expose the HTTP liveness endpoint to local container tooling.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD ["bun", "-e", "fetch('http://127.0.0.1:3300/api/healthz/live').then((response) => { if (!response.ok) process.exit(1) }).catch(() => process.exit(1))"]

# Start Next.js standalone server
CMD ["bun", "server.js"]
