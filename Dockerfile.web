# Build stage
FROM oven/bun:1-alpine AS builder

WORKDIR /app

# Copy package files
COPY package.json bun.lock ./

# Install dependencies (including dev for build)
RUN bun install --frozen-lockfile --ignore-scripts

# Copy source code
COPY . .

# Generate Prisma client (dummy URL — generate never connects)
ENV DATABASE_URL=postgresql://localhost:5432/dummy
RUN bun prisma generate

# AuthKit inlines this public callback during the Next.js build. Keep the
# production value in the image build input; runtime Pod env cannot override it.
ARG NEXT_PUBLIC_WORKOS_REDIRECT_URI
ENV NEXT_PUBLIC_WORKOS_REDIRECT_URI=${NEXT_PUBLIC_WORKOS_REDIRECT_URI}
RUN test -n "$NEXT_PUBLIC_WORKOS_REDIRECT_URI" || \
  (echo "NEXT_PUBLIC_WORKOS_REDIRECT_URI is required for the web image build" >&2 && exit 1)

# Build Next.js
RUN bun run build

# Production stage
FROM oven/bun:1-alpine

WORKDIR /app

# Install only production dependencies
COPY package.json bun.lock ./

# Install with --production flag
RUN bun install --production --ignore-scripts

# Copy generated Prisma client from builder
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma

# Copy Prisma schema for migrations
COPY prisma ./prisma

# Copy built application
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/package.json ./

# Expose port
EXPOSE 3300

# Set production environment
ENV NODE_ENV=production

# Expose the HTTP liveness endpoint to local container tooling.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD ["bun", "-e", "fetch('http://127.0.0.1:3300/api/healthz/live').then((response) => { if (!response.ok) process.exit(1) }).catch(() => process.exit(1))"]

# Start Next.js
# Keep stdout and stderr attached to the container runtime for log collection.
CMD ["bun", "run", "start"]
